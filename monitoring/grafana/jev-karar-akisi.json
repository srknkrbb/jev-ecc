  {
   "id": 1015,
   "type": "timeseries",
   "title": "Kararlar / 10 dk",
   "description": "allow · allow-review · ask · deny · deny-protected · skip-readonly · dry-run",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 34,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "refId": "A",
     "expr": "sum by (jev_decision) (increase(jev_decisions_total{jev_hook=\"guard\"}[10m]))",
     "legendFormat": "{{jev_decision}}",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "noValue": "Jev karari yok",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 1,
      "fillOpacity": 70,
      "gradientMode": "none",
      "showPoints": "never",
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "allow"
      },
      "properties": [
       {
        "id": "color",
        "value": {
