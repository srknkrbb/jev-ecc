     "tableType": "spans",
     "limit": 100,
     "spss": 100,
     "query": "{ resource.service.name = \"jev\" && span.ecc.session.id = \"$session\" } | select(span.ecc.session.id, span.jev.hook, span.jev.decision, span.jev.risk, span.jev.profile, span.tool.name, span.tool.input_summary, span.task.head)"
